  73,00,5c,00,77,00,74,00,2e,00,65,00,78,00,65,00,22,00,20,00,2d,00,64,00,\
  20,00,22,00,25,00,56,00,22,00,20,00,22,00,25,00,55,00,53,00,45,00,52,00,\
